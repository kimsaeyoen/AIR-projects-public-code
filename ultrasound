# --------------------------------
# 2) MODEL: FastRCNNClassifier (classification head over whole image as single RoI)
# --------------------------------
CLASS FastRCNNClassifier(num_classes):
    feature_extractor = ResNet101(pretrained=True)
    REPLACE feature_extractor.conv1 with Conv2d(1->64, k=7, s=2, p=3, bias=False)  # grayscale support
    roi_pool = AdaptiveAvgPool2d((7, 7))  # treat whole feature map as single RoI
    fc = Sequential(
        Linear(2048*7*7 -> 1024), ReLU, Dropout(0.5),
        Linear(1024 -> num_classes)
    )
    forward(x):
        x = feature_extractor.conv1/bn1/relu/maxpool
        x = feature_extractor.layer1/2/3/4
        x = roi_pool(x)
        x = flatten(x)
        logits = fc(x)
        return logits

