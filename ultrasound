# Wrapper to run CAM on YOLO classifier:
FUNCTION visualize_gradcam(model, image_tensor, class_id, save_path):
    model.eval()
    device = device_of(model)

    # Select a convolutional target layer inside the YOLO classifier backbone/head.
    target_layer = model.model.model[-3]         # a late conv layer (implementation-specific)

    CLASS WrappedYOLO(nn.Module):
        INIT(model):
            self.stack = model.model.model       # underlying nn.Module sequence
        FORWARD(x):
            out = self.stack(x)
            RETURN out[0] if tuple else out      # ensure logits tensor

    wrapped = WrappedYOLO(model)

    cam = GradCAM(model=wrapped, target_layers=[target_layer])
    input_tensor = image_tensor.unsqueeze(0).to(device).requires_grad_()

    grayscale_cam = cam(input_tensor=input_tensor,
                        targets=[ClassifierOutputTarget(class_id)])[0]   # (H,W) normalized
    rgb_image = image_tensor.permute(1,2,0).cpu().numpy()
    rgb_image = MINMAX_NORMALIZE(rgb_image)
    overlay   = show_cam_on_image(rgb_image, grayscale_cam, use_rgb=True)
    SAVE_IMAGE(save_path, overlay)

