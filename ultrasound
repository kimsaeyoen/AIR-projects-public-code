# --------------------------------
# 6) PARAMETER COUNTS (for reporting)
# --------------------------------
FUNCTION _to_torch_module(obj):
    IF isinstance(obj, nn.Module): RETURN obj
    m = getattr(obj, "model", None)
    IF isinstance(m, nn.Module): RETURN m
    mm = getattr(m, "model", None)
    IF isinstance(mm, nn.Module): RETURN mm
    RAISE TypeError

FUNCTION print_param_counts(obj, title="[YOLO]"):
    m = _to_torch_module(obj)
    IF DataParallel/Distributed: m = m.module
    total     = SUM(p.numel() for p in m.parameters())
    trainable = SUM(p.numel() for p in m.parameters() if p.requires_grad)
    PRINT f"{title} total: {total} ({total/1e6:.2f} M)"
    PRINT f"{title} trainable: {trainable} ({trainable/1e6:.2f} M)"

final_model = YOLO(f"runs/classify/{RUN_NAME}/weights/best.pt")
print_param_counts(final_model, title="[YOLOv11-cls best.pt]")

# --------------------------------
# 7) EVALUATION (Validation & Test)
# --------------------------------
# Utility to run classification predictions using Ultralytics .predict
FUNCTION evaluate(model, images_np, labels_ids, name):
    preds = []
    FOR img_np, lbl_id IN zip(images_np, labels_ids):
        img_pil = to_PIL(img_np.astype(uint8))
        pred    = model.predict(img_pil, imgsz=640, verbose=False)[0]
        preds.append(int(pred.probs.top1))
    trues = [int(y) for y in labels_ids]

    acc  = Accuracy(trues, preds)
    prec = Precision_macro(trues, preds, zero_division=0)
    rec  = Recall_macro(trues, preds, zero_division=0)
    cm   = ConfusionMatrix(trues, preds)   # shape KxK

    # Specificity (macro): mean over classes
    specs = []
    FOR i in [0..K-1]:
        tn = sum(cm) - row_sum(i) - col_sum(i) + cm[i,i]
        fp = col_sum(i) - cm[i,i]
        spec_i = tn / (tn + fp) if denom>0 else 0
        specs.append(spec_i)
    spec = mean(specs)

    # (Optionally) F1 macro
    f1 = F1_macro(trues, preds, zero_division=0)

    PRINT name, acc, prec, rec, spec, f1
    PLOT_HEATMAP(cm, title=f"{name} Confusion Matrix",
                 save_path=DATA_DIR + f"/{lower(name)}_confusion_matrix.png")

# Gather arrays for evaluation
val_imgs_np  = LOAD_IMAGES_AS_ARRAYS(val_paths)   # each HxW or HxWxC uint8
