# --------------------------------
# 3) MODEL: ResNetImage (ResNet101 backbone)
# --------------------------------
CLASS ResNetImage(num_classes):
    base = ResNet101(pretrained=True)
    REPLACE base.conv1 with Conv2d(in_channels=1, out=64, k=7, s=2, p=3, bias=False)  # grayscale support
    in_features = base.fc.in_features
    REPLACE base.fc with Sequential(Dropout(p=0.5), Linear(in_features -> num_classes))
    forward(x): return base(x)

