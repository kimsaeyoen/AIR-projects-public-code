FUNCTION load_preprocess(path, target_size=(512,512)):
    load grayscale; to array; /255.0; expand dims -> (1,H,W,1)
    RETURN tensor

FUNCTION resolve_layer_by_path(model, path_str):
    # e.g., "vgg19/block5_conv4"
    traverse model.get_layer(path) elements by "/"
    RETURN layer

FUNCTION make_gradcam_heatmap(img_tensor, model, last_conv_layer_path, pred_index=None):
    conv_layer = resolve_layer_by_path(model, last_conv_layer_path)
    grad_model = Model(inputs=model.inputs, outputs=[conv_layer.output, model.output])
    WITH GradientTape:
        conv_out, preds = grad_model(img_tensor, training=False)
        IF pred_index is None: pred_index = argmax(preds[0])
        loss = preds[:, pred_index]
    grads   = gradient(loss, conv_out)
    weights = mean(grads over (H,W))
    heatmap = sum(conv_out[0] * weights over channels)
    RELU(heatmap); normalize to [0,1]
    RETURN heatmap

FUNCTION save_superimposed(src_path, heatmap, save_path, alpha=0.4):
