    # ---- Evaluate on TEST (as per code) ----
    (acc, prec, rec, spec) = calculate_metrics(model, test_loader, device)
    PRINT epoch, total_loss, acc, prec, rec, spec

    # ---- Checkpoints ----
    IF epoch IN CHECKPOINT_EPOCHS:
        SAVE {
            'epoch': epoch,
            'model_state_dict': model.state_dict(),
            'optimizer_state_dict': optimizer.state_dict()
        } TO f"{CHECKPOINT_DIR}/checkpoint_{epoch}.pth"

    # ---- Analysis at epoch == 100 ----
    IF epoch == 100:
        save_dir = "./grad_cam_output"; MAKE_DIR(save_dir)
        png_paths = sorted(list all *.png under GRADCAM_INPUT_DIR)
        IF png_paths is empty: WARN no files
