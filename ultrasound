# 8) GRAD-CAM CORE (ABSTRACT)
# -----------------------------
CLASS GradCAM(model, target_layer):
    REGISTER forward hook on target_layer to cache activations
    REGISTER backward hook on target_layer to cache gradients

    METHOD generate_cam(input_tensor, class_idx=None):
        model.eval()
        x = add_batch_dim(input_tensor).to(device_of_model)
        logits = model(x)
        IF class_idx is None: class_idx = argmax(logits[0])
        ZERO grad on model
        loss = logits[0, class_idx]
        BACKWARD(loss)
        grads = cached_gradients[0]          # (C,H,W)
        acts  = cached_activations[0]        # (C,H,W)
        weights = mean(grads over spatial dims)  # (C,1,1)
        cam = sum(weights * acts over channels)  # (H,W)
        RELU(cam); RESIZE to (IMG_SIZE, IMG_SIZE)
        NORMALIZE to [0,1]
        RETURN cam
