FUNCTION calculate_metrics(model, dataloader, device):
    model.eval(); INIT all_labels=[], all_preds=[]
    NO GRAD:
        FOR images, labels, _ IN dataloader:
            move to device
            logits = model(images)
            preds  = argmax(logits, dim=1)
            append labels and preds (cpu numpy)
    accuracy  = Accuracy(all_labels, all_preds)
    precision = Precision_macro(all_labels, all_preds, zero_division=0)
    recall    = Recall_macro(all_labels, all_preds, zero_division=0)
    CM = ConfusionMatrix(all_labels, all_preds)
    specificity_per_class:
        FOR each class i:
            tn = sum(CM) - row_sum(i) - col_sum(i) + CM[i,i]
            fp = col_sum(i) - CM[i,i]
            spec_i = tn / (tn + fp) if denom>0 else 0
    specificity = mean(spec_i)
    RETURN accuracy, precision, recall, specificity

FUNCTION measure_single_image_inference(model, image_path, device, n_runs=100, warmup=10):
    model.eval()
    preprocess = Transform (same as above)
    input_tensor = preprocess(load image as "L").unsqueeze(0).to(device)
    IF device is CUDA:
        pre-create start/end CUDA events
    NO GRAD:
        RUN warmup passes
        INIT times=[]
        REPEAT n_runs:
            IF CUDA:
                record start; forward(model, input_tensor); record end; synchronize; append elapsed_ms
            ELSE:
                t0 = wallclock(); forward(); append (wallclock()-t0)*1000
    RETURN times  # list of ms

# --------------------------------
# 5) GRAD-CAM (target: layer4)
# --------------------------------
CLASS GradCAM(model, target_layer):
    REGISTER forward hook on target_layer to cache activations
    REGISTER full backward hook on target_layer to cache gradients
    METHOD generate_cam(input_image_tensor, target_class):
        model.eval()
        x = input_image_tensor.unsqueeze(0).to(device)
        logits = model(x)
        model.zero_grad()
        class_score = logits[:, target_class]
        BACKWARD(class_score)
        weights = mean(gradients over H,W; keepdim)
        cam = sum(weights * activations over channels)
        RELU(cam)
        RESIZE cam to (IMG_SIZE, IMG_SIZE)
        NORMALIZE cam to [0,1]
        RETURN cam

FUNCTION visualize_gradcam(image_path, model, grad_cam, save_dir, epoch=None):
    ensure save_dir
    input_tensor = Transform(load image as "L")
    with NO GRAD:
        pred_class = argmax(model(input_tensor.unsqueeze(0).to(device)), dim=1)
    cam = grad_cam.generate_cam(input_tensor, pred_class)
    bgr = cv2.imread(image_path); resize to (IMG_SIZE, IMG_SIZE)
    heatmap = applyColorMap(uint8(255*cam), JET)
    blended = addWeighted(bgr, 0.5, heatmap, 0.5)
    fname = stem(image_path)
    out = f"{save_dir}/{fname}_epoch{epoch}.png" if epoch else f"{save_dir}/{fname}_gradcam.png"
    write out image

INIT grad_cam = GradCAM(model, target_layer = model.resnet.layer4)

