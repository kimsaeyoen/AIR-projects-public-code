    on_epoch_end(epoch, logs):
        if (epoch+1) in epochs_to_watch:
            FOR each path in pngs:
                inp = load_preprocess(path)
                hm  = make_gradcam_heatmap(inp, self.model, target_layer_path)
                save_superimposed(path, hm, f"{save_dir}/epoch{epoch+1}_{basename(path)}")

